#include<stdio.h>
int main(){
    int a,bmax=0,cmax=0;
    long long arr[30],x=0,y=-2;
    scanf("%d",&a);
    for(int i=0;i<a;i++){
        scanf("%lld",&arr[i]);
        int e=arr[i],b=0,c=0;
        while(e>0){
            int f=e%10;
            if(f%2==0){
                b++;
                c=c+f;
            }
            e=e/10;
        }
        if(b>bmax){
            bmax=b;
            x=arr[i];
        }
        if(c>cmax){
            cmax=c;
            y=arr[i];
        }
    }
    if(x==y){
        printf("Yes %lld %d %d",x,bmax,cmax);
    }
    else{
        printf("No");
    }
}
